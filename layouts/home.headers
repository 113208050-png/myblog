{{- /* Cloudflare _headers：讓純文字檔帶 charset=utf-8，中文才不會亂碼 */ -}}
/llms.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
{{ range site.Pages }}
{{- with .OutputFormats.Get "markdown" }}
{{ .RelPermalink }}
  Content-Type: text/markdown; charset=utf-8
{{ end }}
{{- end }}
